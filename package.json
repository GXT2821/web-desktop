{
  "name": "doc-vault",
  "version": "1.2.0",
  "description": "在线文档收藏夹：把散落在浏览器标签里的文档链接长期保存下来",
  "author": "GT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/store.test.js",
    "icons": "electron scripts/build-icons.js --force-device-scale-factor=1",
    "pack": "electron-builder --dir",
    "build": "node scripts/build.js",
    "build:win": "node scripts/build.js win",
    "build:mac": "node scripts/build.js mac",
    "build:linux": "node scripts/build.js linux",
    "build:all": "node scripts/build.js all"
  },
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.gt.docvault",
    "productName": "文档库",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "DocVault-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleLocalizations": [
          "zh-Hans",
          "zh_CN",
          "en"
        ],
        "CFBundleDevelopmentRegion": "zh-Hans"
      },
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "artifactName": "DocVault-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "electronDownload": {
      "cache": ".cache-electron"
    }
  }
}
