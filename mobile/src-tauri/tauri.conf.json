{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocVault",
  "version": "1.2.0",
  "identifier": "com.gt.docvault",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "node prepare.js",
    "beforeDevCommand": "node prepare.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "文档库",
        "width": 1100,
        "height": 820,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "在线文档收藏夹",
    "longDescription": "只保存链接与备注的在线文档收藏夹，支持文件夹、标签、搜索，文档在系统浏览器中打开。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}